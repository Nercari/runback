{
  "name": "wow-ai",
  "version": "0.4.0",
  "private": true,
  "description": "Chat with local Claude Code, Codex and Grok sessions from inside World of Warcraft: Forever, with no UI reloads. Pixel strip out, load-on-demand slots in.",
  "license": "MIT",
  "author": "chelinho139",
  "repository": {
    "type": "git",
    "url": "https://github.com/chelinho139/wow-ai"
  },
  "keywords": [
    "world-of-warcraft",
    "wow-addon",
    "claude-code",
    "claude",
    "codex",
    "grok",
    "coding-agent",
    "bridge"
  ],
  "engines": {
    "node": ">=22.2"
  },
  "bin": {
    "wow-ai": "bridge/supervisor.js"
  },
  "scripts": {
    "setup": "node setup.js",
    "doctor": "node tools/doctor.js",
    "start": "node bridge/supervisor.js",
    "slots": "node bridge/install-slots.js",
    "test": "node tests/run_all.js",
    "test:live": "node tests/inject_test.js",
    "changelog": "node tools/changelog.js",
    "version": "node tools/changelog.js release && git add CHANGELOG.md changes",
    "probe": "python3 bridge/capture_x11.py --probe bridge/probe.png"
  },
  "devDependencies": {
    "fengari": "^0.1.4",
    "luaparse": "^0.3.1"
  }
}
